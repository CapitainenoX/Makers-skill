# Maker workspaces are generated per project, never committed
.maker/
**/__pycache__/
*.pyc

# Remotion install artefacts — the template source is committed, its deps are not
node_modules/
skills/maker/remotion/out/
skills/maker/remotion/public/*
!skills/maker/remotion/public/.gitkeep

# Media never belongs in the skill repo
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.wav
*.m4a
*.png
*.jpg
*.jpeg
!docs/**/*.png
